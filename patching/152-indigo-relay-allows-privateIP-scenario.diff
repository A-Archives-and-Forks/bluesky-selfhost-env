+// check if scenario is PublicOnly by reading env var(INDIGO_SSRF_PUBLIC_ONLY_SCENARIO)
+//   false: only when env var exists and its value is false.
+//   true:  otherwise(no env, parse error, value is true).
+// it may be better to pass from cmd/... but changes should be the smallest.
+func isPublicOnlyScenario() bool {
+    publicOnly := true // default
+    if v, ok := os.LookupEnv("INDIGO_SSRF_PUBLIC_ONLY_SCENARIO"); ok {
+        parsed, err := strconv.ParseBool(v)
+        if err == nil {
+            publicOnly = parsed
+        }
+    }
+
+    return publicOnly
+}
